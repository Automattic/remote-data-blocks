# Specify which files should not be included in the push to WordPress.org.
# These are all development files and directories.
# The deploy Action will use rsync + .distignore if the .distignore exists,
# so it doesn't care what may or may not be ignored via .gitignore.

/.git/
/.github/
/.cursor/
/.husky/
/.vscode/
/bin/
/docs/
/example/
/node_modules/
/src/
/tests/
/types/
/.babelrc
/.distignore
/.editorconfig
/.eslintignore
/.eslintrc.js
/.gitattributes
/.gitignore
/.lintstagedrc.json
/.nvmrc
/.prettierignore
/.prettierrc
/.wp-env.json
/.phpcs.xml.dist
/blueprint.local.json
/blueprint.settings.json
/CHANGELOG.md
/CONTRIBUTING.md
/composer.lock
/package-lock.json
/phpcs.xml
/phpunit.xml
/phpunit.xml.dist
/phpunit-integration.xml
/playwright.config.ts
/psalm.xml
/SECURITY.md
/tsconfig.json
/vitest.config.mts
/webpack.config.js
/webpack.utils.js
