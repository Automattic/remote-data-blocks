#!/bin/sh

set -eu

if [ "$#" -lt 1 ] || [ "$#" -gt 2 ]; then
	printf 'Usage: %s <major|minor|patch|none> [stable|alpha|beta]\n' "$0" >&2
	exit 1
fi

if [ -n "$(git status --porcelain)" ]; then
	printf 'Commit or stash local changes before preparing a release.\n' >&2
	exit 1
fi

current_version=$(sed -n 's/.*Version: *//p' remote-data-blocks.php | head -n 1 | tr -d '[:space:]')
new_version=$(node tools/release/version.mjs "$current_version" "$1" "${2:-stable}")
branch="release/v$new_version"

if git show-ref --verify --quiet "refs/heads/$branch"; then
	printf 'Release branch %s already exists.\n' "$branch" >&2
	exit 1
fi

node --input-type=module - "$current_version" "$new_version" <<'NODE'
import { readFileSync, writeFileSync } from 'node:fs';

const [ current, next ] = process.argv.slice( 2 );
const phpFile = 'remote-data-blocks.php';
const readmeFile = 'readme.txt';
let php = readFileSync( phpFile, 'utf8' );
let readme = readFileSync( readmeFile, 'utf8' );
const header = /^( \* Version: )(.+)$/m;
const constant = /^(define\( 'REMOTE_DATA_BLOCKS__PLUGIN_VERSION', ')([^']+)(' \);)$/m;
const stableTag = /^(Stable tag: )(.+)$/m;

if ( php.match( header )?.[ 2 ] !== current || php.match( constant )?.[ 2 ] !== current ) {
	throw new Error( 'Plugin header and version constant must match before releasing.' );
}
if ( ! readme.match( stableTag ) ) {
	throw new Error( 'Missing Stable tag in readme.txt.' );
}

php = php.replace( header, ( _, prefix ) => prefix + next );
php = php.replace( constant, ( _, prefix, old, suffix ) => prefix + next + suffix );
// Prereleases do not change the WordPress.org stable version.
if ( ! next.includes( '-' ) ) {
	readme = readme.replace( stableTag, ( _, prefix ) => prefix + next );
}
writeFileSync( phpFile, php );
writeFileSync( readmeFile, readme );
NODE

git checkout -b "$branch"
git add remote-data-blocks.php readme.txt
git commit -m "v$new_version"

printf 'Prepared %s on %s. Push this branch and open a PR against trunk.\n' "$new_version" "$branch"
