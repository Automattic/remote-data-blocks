        "body": {
          "mode": "json",
          "json": "{\n   \"type\":\"Cart\",\n   \"currencyIsoCode\": \"USD\"\n}",
          "formUrlEncoded": [],
          "multipartForm": [],
          "file": []
        },
        "script": {
          "req": "const { v4: uuidv4 } = require('uuid');\n\nconst site_id = bru.getEnvVar(\"site-id\").substring(0, 15);\nconst uuid = uuidv4();\nreq.setHeader(\"Cookie\", `guest_uuid_essential_${site_id}=${uuid}`);\n",
          "res": "const response = res.getBody();\nconst cart_id = response.cartId;\n\nbru.setEnvVar('guest-cart-id', cart_id);"
        },
