meta {
  name: Auth
  type: http
  seq: 1
}

post {
  url: https://{{salesforce-domain}}.my.salesforce.com/services/oauth2/token?grant_type=client_credentials&client_id={{client-id}}&client_secret={{client-secret}}
  body: none
  auth: none
}

params:query {
  grant_type: client_credentials
  client_id: {{client-id}}
  client_secret: {{client-secret}}
}

headers {
  Content-Type: application/x-www-form-urlencoded
}

script:post-response {
  const response = res.getBody();
  const access_token = response.access_token;
  
  bru.setVar('access-token', access_token);
  
}
