meta {
  name: Start Checkout
  type: http
  seq: 1
}

put {
  url: https://{{salesforce-domain}}.my.site.com/{{store-name}}/webruntime/api/services/data/v63.0/commerce/webstores/{{webstore-id}}/checkouts
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access-token}}
}

body:json {
  {
    "cartId": "{{guest-cart-id}}",
    "deliveryAddressInput": {
       "name": "A G",
       "firstName": "A",
       "lastName": "G",
       "shipToPhoneNumber": "",
       "companyName": "Automattic",
       "street": "166 Crosby St",
       "city": "New York",
       "region": "NY",
       "country": "US",
       "postalCode": "10012"
    }
  }
  
}

script:pre-request {
  const cookie_essential = bru.getVar("cookie-guest-essential");
  const cookie_cart_session = bru.getVar("cookie-guest-cart-session");
  
  if (cookie_essential && cookie_cart_session) {
    const cookies = `${cookie_essential}; ${cookie_cart_session};`;
    req.setHeader("Cookie", cookies);
  }
  
}

script:post-response {
  const response = res.getBody();
  const checkout_id = response.checkoutId;
  
  bru.setVar('guest-checkout-id', checkout_id);
  
}
