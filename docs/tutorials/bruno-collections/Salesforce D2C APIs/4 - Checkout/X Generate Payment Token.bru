meta {
  name: X Generate Payment Token
  type: http
  seq: 4
}

post {
  url: https://{{salesforce-domain}}.my.site.com/{{store-name}}/webruntime/api/services/data/v63.0/commerce/webstores/{{webstore-id}}/payments/token
  body: json
  auth: none
}

body:json {
