meta {
  name: Get Checkout
  type: http
  seq: 2
}

get {
  url: https://{{salesforce-domain}}.my.site.com/{{store-name}}/webruntime/api/services/data/v63.0/commerce/webstores/{{webstore-id}}/checkouts/{{guest-checkout-id}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access-token}}
}

script:pre-request {
  const cookie_essential = bru.getVar("cookie-guest-essential");
  const cookie_cart_session = bru.getVar("cookie-guest-cart-session");
  
  if (cookie_essential && cookie_cart_session) {
    const cookies = `${cookie_essential}; ${cookie_cart_session};`;
    req.setHeader("Cookie", cookies);
  }
  
}
